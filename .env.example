# PayPal. Leave both blank for mock mode.
# Set both PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET to use the sandbox. No other PayPal variable is required.
# PAYPAL_MODE=mock forces mock even when credentials are present. PAYPAL_MODE=sandbox requires both credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional. When true, capture sends a PayPal sandbox test card.
# The sandbox app needs card processing enabled. Leave false to send an empty capture body.
# Card numbers are published by PayPal: https://developer.paypal.com/tools/sandbox/card-testing/
PAYPAL_CAPTURE_WITH_TEST_CARD=false
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=2030-12
PAYPAL_TEST_CARD_CVV=
PAYPAL_TEST_CARD_NAME=Test Buyer

# AI provider: auto (default), openai, cloudflare, or offline.
# auto uses OpenAI when OPENAI_API_KEY is set, otherwise Cloudflare when both Cloudflare values are set, otherwise the offline rules extractor.
AI_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Maximum chat completions calls in one server process. Default 20.
OPENAI_MAX_CALLS=20

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
