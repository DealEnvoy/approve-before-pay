# PayPal. Leave both blank for mock mode.
# Set both PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET to use the sandbox. No other PayPal variable is required.
# PAYPAL_MODE=mock forces mock even when credentials are present. PAYPAL_MODE=sandbox requires both credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional. When true, capture sends a PayPal sandbox test card.
# The sandbox app needs card processing enabled. Leave false to send an empty capture body.
# Card numbers are published by PayPal: https://developer.paypal.com/tools/sandbox/card-testing/
PAYPAL_CAPTURE_WITH_TEST_CARD=false
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=2030-12
PAYPAL_TEST_CARD_CVV=
PAYPAL_TEST_CARD_NAME=Test Buyer

# AI provider: auto (default), cloudflare, openai, or offline.
# auto uses Cloudflare Workers AI when CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN are set.
# If those are absent and OPENAI_API_KEY is set, auto uses OpenAI. Otherwise the offline rules extractor runs.
AI_PROVIDER=auto

# Workers AI is the default model. Free tier uses the same REST run endpoint.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override. Default is @cf/meta/llama-3.3-70b-instruct-fp8-fast
CF_AI_MODEL=

# Optional OpenAI fallback. Used only when Workers AI credentials are absent, or when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Maximum model calls in one server process for the active provider. Default 20.
AI_MAX_CALLS=20
